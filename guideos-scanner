def get_pixmap_icon(icon_name):
    """Sucht nach PNG-Icons zuerst in /usr/share/pixmaps/, dann im lokalen icons/-Ordner."""
    sys_path = Path("/usr/share/pixmaps") / f"{icon_name}.png"
    local_path = Path(__file__).parent / "icons" / f"{icon_name}.png"

    if sys_path.exists():
        return QIcon(str(sys_path))
    elif local_path.exists():
        return QIcon(str(local_path))
    return QIcon()


def get_config_path():
    config_dir = Path.home() / ".config" / "scanner_app"
    config_dir.mkdir(parents=True, exist_ok=True)
    return config_dir / "profiles.json"

def load_user_profiles():
    path = get_config_path()
    profiles = DEFAULT_PROFILES.copy()
    if path.exists():
        try:
            with open(path, "r", encoding="utf-8") as f:
                user_profs = json.load(f)
                profiles.update(user_profs)
        except Exception as e:
            print(f"Fehler beim Laden der Profile: {e}")
    return profiles

def save_user_profiles(profiles):
    path = get_config_path()
    try:
        with open(path, "w", encoding="utf-8") as f:
            json.dump(profiles, f, indent=4, ensure_ascii=False)
    except Exception as e:
        print(f"Fehler beim Speichern der Profile: {e}")


class SaneInitWorker(QThread):
    finished = pyqtSignal(list)

    def run(self):
        try:
            sane.init()
            devices = sane.get_devices()
        except Exception as e:

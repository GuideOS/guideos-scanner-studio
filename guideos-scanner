    def populate_devices(self):
        self.device_combo.clear()
        if self.devices:
            for dev in self.devices:
                self.device_combo.addItem(f"{dev[1]} {dev[2]}", dev[0])
        else:
            self.device_combo.addItem("Demo / Kein Scanner gefunden", None)

    def populate_default_sources(self):
        self.source_combo.clear()
        self.source_combo.addItem("Flachbett", "Flatbed")
        self.source_combo.addItem("Einzug (ADF)", "ADF")
        self.source_combo.addItem("Durchlichteinheit (TPU)", "Transparency")

    def on_source_changed(self):
        src = str(self.source_combo.currentData() or self.source_combo.currentText()).upper()
        if "ADF" in src or "FEEDER" in src:
            self.btn_preview.setEnabled(False)
            self.btn_preview.setToolTip("Vorschau ist bei ADF-Einzug deaktiviert.")
        else:
            self.btn_preview.setEnabled(True)
            self.btn_preview.setToolTip("")

    def load_profile(self, profile_name):
        if profile_name in self.profiles:
            p = self.profiles[profile_name]
            self.dpi_spin.setValue(p.get("dpi", 300))

            idx_mode = self.mode_combo.findData(p.get("mode", "color"))
            if idx_mode >= 0: self.mode_combo.setCurrentIndex(idx_mode)

            src_val = p.get("source", "Flatbed")
            idx_src = self.source_combo.findData(src_val)
            if idx_src >= 0:
                self.source_combo.setCurrentIndex(idx_src)
            else:
                self.source_combo.setCurrentText(src_val)

            self.chk_invert.setChecked(p.get("invert_negative", False))
            self.chk_ocr.setChecked(p.get("ocr", False))
            self.chk_deskew.setChecked(p.get("deskew", False))
            self.chk_autocrop.setChecked(p.get("autocrop", False))
            self.spin_brightness.setValue(p.get("brightness", 1.0))
            self.spin_contrast.setValue(p.get("contrast", 1.0))
            self.spin_offset_x.setValue(p.get("offset_x", 0.0))
            self.spin_offset_y.setValue(p.get("offset_y", 0.0))
            self.selected_format = p.get("format", "PDF")
            self.on_source_changed()

    def save_custom_profile(self):
        name, ok = QInputDialog.getText(self, "Profil speichern", "Name für das neue Profil:")
        if ok and name:
            self.profiles[name] = {
                "dpi": self.dpi_spin.value(),
                "mode": self.mode_combo.currentData(),
                "source": self.source_combo.currentData() or self.source_combo.currentText(),
                "invert_negative": self.chk_invert.isChecked(),
                "format": self.selected_format,
                "ocr": self.chk_ocr.isChecked(),
                "deskew": self.chk_deskew.isChecked(),
                "autocrop": self.chk_autocrop.isChecked(),
                "brightness": self.spin_brightness.value(),
                "contrast": self.spin_contrast.value(),
                "offset_x": self.spin_offset_x.value(),
                "offset_y": self.spin_offset_y.value()
            }
            save_user_profiles(self.profiles)

            if self.profile_combo.findText(name) == -1:
                self.profile_combo.addItem(name)
            self.profile_combo.setCurrentText(name)
            QMessageBox.information(self, "Erfolg", f"Profil '{name}' wurde gespeichert.")

    def open_sane_device(self):
        dev_name = self.device_combo.currentData()
        if not dev_name:
            return None
        try:
            return sane.open(dev_name)
        except Exception as e:
            QMessageBox.critical(self, "Fehler", f"Scanner konnte nicht geöffnet werden:\n{e}")
            return None

    def apply_sane_options(self, dev):
        try:
            dev.mode = self.mode_combo.currentData()
        except Exception:
            pass

        selected_source = str(self.source_combo.currentData() or self.source_combo.currentText())
        if hasattr(dev, 'source'):
            try:
                dev.source = selected_source
            except Exception as e:
                print(f"Hinweis beim Setzen der Scan-Quelle: {e}")

    def scan_preview(self):
        dev = self.open_sane_device()
        if dev:
            try:
                self.apply_sane_options(dev)

                dev_name = str(self.device_combo.currentData() or "")
                is_escl = "escl" in dev_name.lower()

                try:
                    dev.resolution = 75
                except Exception:
                    pass

                if not is_escl:
                    try:
                        if hasattr(dev, 'tl_x_range') and hasattr(dev, 'tl_y_range'):
                            dev.tl_x = dev.tl_x_range[0]
                            dev.tl_y = dev.tl_y_range[0]
                            dev.br_x = dev.tl_x_range[1]
                            dev.br_y = dev.tl_y_range[1]
                    except Exception as ex:
                        print(f"Hinweis Vorschau-Grenzen: {ex}")

                dev.start()
                self.preview_pil_image = dev.snap()
            except Exception as e:
                QMessageBox.warning(self, "Scan-Fehler", f"Vorschau fehlgeschlagen:\n{e}")
                return
            finally:
                try:
                    dev.close()
                except Exception:
                    pass
        else:
            self.preview_pil_image = Image.new("RGB", (1240, 1754), color=(255, 255, 255))
            QMessageBox.information(self, "Demo-Modus", "Demo-Vorschau geladen.")

        if self.chk_invert.isChecked():
            self.preview_pil_image = ImageProcessor.invert_negative(self.preview_pil_image)

        self.preview_view.set_image(self.preview_pil_image)

    def start_scan_process(self):
        src = str(self.source_combo.currentData() or self.source_combo.currentText()).upper()

        if "ADF" in src or "FEEDER" in src:
            self.scan_adf()
        else:
            self.scan_single_page()

    def scan_adf(self):
        dev = self.open_sane_device()
        if not dev:
            QMessageBox.information(self, "Demo-Modus", "Simuliere ADF Scan (1 Seite)...")
            img = self.preview_pil_image.copy() if self.preview_pil_image else Image.new("RGB", (1240, 1754), (255, 255, 255))
            self.process_and_add_image(img, force_deskew=True)
            return

        pages_scanned = 0
        try:
            self.apply_sane_options(dev)
            dev.resolution = self.dpi_spin.value()

            while True:
                try:
                    if hasattr(dev, 'br_x') and hasattr(dev, 'br_y'):
                        dev.tl_x = 0.0
                        dev.tl_y = 0.0

                        max_x = dev.br_x_range[1] if hasattr(dev, 'br_x_range') else 210.0
                        max_y = dev.br_y_range[1] if hasattr(dev, 'br_y_range') else 297.0

                        dev.br_x = max_x
                        dev.br_y = max_y

                    dev.start()
                    scanned_img = dev.snap()

                    if scanned_img is not None and scanned_img.width > 0 and scanned_img.height > 0:
                        self.process_and_add_image(scanned_img, force_deskew=True)
                        pages_scanned += 1
                    else:
                        break

                except (sane._sane.error, EOFError, RuntimeError, Exception) as e:
                    print(f"ADF Ende / Puffer geleert: {e}")
                    break

            try:
                dev.close()
            except Exception:
                pass

            if pages_scanned > 0:
                QMessageBox.information(
                    self, "ADF Fertig",
                    f"Alle {pages_scanned} Seite(n) erfolgreich erfasst!"
                )
            else:
                QMessageBox.warning(
                    self, "ADF Leer",
                    "Keine Seiten erfasst. Bitte prüfe den Papiereinzug."
                )

        except Exception as e:
            QMessageBox.critical(self, "ADF-Fehler", f"Fehler beim ADF-Scan:\n{e}")
        finally:
            try:
                dev.close()
            except Exception:
                pass

    def scan_single_page(self):
        selection = self.preview_view.get_selection_rect()
        dev = self.open_sane_device()

        if dev:
            try:
                self.apply_sane_options(dev)
                dev.resolution = self.dpi_spin.value()

                dev_name = str(self.device_combo.currentData() or "")
                is_escl = "escl" in dev_name.lower()
                selected_source = str(self.source_combo.currentData() or self.source_combo.currentText()).upper()
                is_transparency = "TRANSPARENCY" in selected_source or "TPU" in selected_source

                # Nur Hardware-Bereich setzen, wenn es kein eSCL UND kein Durchlicht (TPU) ist
                if selection and not is_escl and not is_transparency and self.preview_pil_image:
                    try:
                        x1, y1, x2, y2 = selection
                        w_pixel, h_pixel = self.preview_pil_image.size

                        min_x = dev.tl_x_range[0] if hasattr(dev, 'tl_x_range') else 0.0
                        max_x = dev.tl_x_range[1] if hasattr(dev, 'tl_x_range') else 215.9
                        min_y = dev.tl_y_range[0] if hasattr(dev, 'tl_y_range') else 0.0
                        max_y = dev.tl_y_range[1] if hasattr(dev, 'tl_y_range') else 297.0

                        span_x = max_x - min_x
                        span_y = max_y - min_y

                        off_x = self.spin_offset_x.value()
                        off_y = self.spin_offset_y.value()

                        calc_tl_x = min_x + (x1 / w_pixel) * span_x + off_x
                        calc_tl_y = min_y + (y1 / h_pixel) * span_y + off_y
                        calc_br_x = min_x + (x2 / w_pixel) * span_x + off_x
                        calc_br_y = min_y + (y2 / h_pixel) * span_y + off_y

                        dev.tl_x = float(max(min_x, min(calc_tl_x, max_x)))
                        dev.tl_y = float(max(min_y, min(calc_tl_y, max_y)))
                        dev.br_x = float(max(min_x, min(calc_br_x, max_x)))
                        dev.br_y = float(max(min_y, min(calc_br_y, max_y)))
                    except Exception as ex:
                        print(f"Hinweis Auswahl-Grenzen: {ex}")
                else:
                    # Bei Durchlicht oder eSCL: Volle Fläche anfordern
                    try:
                        if hasattr(dev, 'tl_x_range') and hasattr(dev, 'tl_y_range'):
                            dev.tl_x = dev.tl_x_range[0]
                            dev.tl_y = dev.tl_y_range[0]
                            dev.br_x = dev.tl_x_range[1]
                            dev.br_y = dev.tl_y_range[1]
                    except Exception as ex:
                        print(f"Hinweis Volles Fenster: {ex}")

                dev.start()
                scanned_img = dev.snap()

                # Bei eSCL ODER Durchlichteinheit den Auswahlrahmen per Software zuschneiden
                if selection and (is_escl or is_transparency) and self.preview_pil_image:
                    x1, y1, x2, y2 = selection
                    w_prev, h_prev = self.preview_pil_image.size
                    w_scan, h_scan = scanned_img.size

                    # Umrechnung der Vorschau-Koordinaten auf die volle Scan-Auflösung
                    crop_x1 = int((x1 / w_prev) * w_scan)
                    crop_y1 = int((y1 / h_prev) * h_scan)
                    crop_x2 = int((x2 / w_prev) * w_scan)
                    crop_y2 = int((y2 / h_prev) * h_scan)

                    scanned_img = scanned_img.crop((crop_x1, crop_y1, crop_x2, crop_y2))

            except Exception as e:
                QMessageBox.critical(self, "Scan-Fehler", f"Scan fehlgeschlagen:\n{e}")
                return
            finally:
                try:
                    dev.close()
                except Exception:
                    pass
        else:
            if selection and self.preview_pil_image:
                scanned_img = self.preview_pil_image.crop(selection)
            elif self.preview_pil_image:
                scanned_img = self.preview_pil_image.copy()
            else:
                scanned_img = Image.new("RGB", (2480, 3508), (255, 255, 255))

        pages_before = len(self.scanned_pages)
        self.process_and_add_image(scanned_img, is_cropped=bool(selection))
        added_count = len(self.scanned_pages) - pages_before

        QMessageBox.information(
            self, "Erfassung erfolgreich",
            f"Es wurde(n) {added_count} Foto(s)/Seite(n) erfasst!\n"
            f"Gesamtanzahl im Speicher: {len(self.scanned_pages)}"
        )

    def process_and_add_image(self, scanned_img, is_cropped=False, force_deskew=False):
        if scanned_img.mode != "RGB":
            scanned_img = scanned_img.convert("RGB")

        if self.chk_invert.isChecked():
            scanned_img = ImageProcessor.invert_negative(scanned_img)

        if self.chk_autocrop.isChecked() and not is_cropped:
            extracted_images = ImageProcessor.extract_photos(scanned_img)
        else:
            extracted_images = [scanned_img]

        for img in extracted_images:
            if (self.chk_deskew.isChecked() and not is_cropped) or force_deskew:
                img = ImageProcessor.deskew(img)

            img = ImageProcessor.adjust_brightness_contrast(
                img,
                brightness=self.spin_brightness.value(),
                contrast=self.spin_contrast.value()
            )
            self.scanned_pages.append(img)

        self.lbl_page_count.setText(f"Gescannte Seiten: {len(self.scanned_pages)}")

    def save_final_document(self):
        if not self.scanned_pages:
            QMessageBox.warning(self, "Keine Seiten", "Es wurden noch keine Seiten erfasst!")
            return

        filter_pdf = "PDF Dokument (*.pdf)"
        filter_jpg = "JPEG Bild (*.jpg)"
        filter_png = "PNG Bild (*.png)"

        if self.selected_format.upper() == "PDF" or self.chk_ocr.isChecked():
            file_filter = f"{filter_pdf};;{filter_jpg};;{filter_png}"
            initial_filter = filter_pdf
        else:
            file_filter = f"{filter_jpg};;{filter_pdf};;{filter_png}"
            initial_filter = filter_jpg

        file_path, selected_filter = QFileDialog.getSaveFileName(
            self, "Dokument speichern", "Scan_Dokument", file_filter, initialFilter=initial_filter
        )

        if not file_path:
            return

        base, ext = os.path.splitext(file_path)
        if not ext:
            if "PNG" in selected_filter:
                ext = ".png"
            elif "JPEG" in selected_filter or "JPG" in selected_filter:
                ext = ".jpg"
            else:
                ext = ".pdf"
            file_path = base + ext

        try:
            dpi_val = (float(self.dpi_spin.value()), float(self.dpi_spin.value()))

            if ext.lower() == ".pdf":
                if self.chk_ocr.isChecked():
                    if HAS_PYPDF:
                        writer = PdfWriter()
                        for img in self.scanned_pages:
                            pdf_bytes = run_native_ocr_pdf(img, lang="deu+eng")
                            reader = PdfReader(io.BytesIO(pdf_bytes))
                            writer.add_page(reader.pages[0])
                        with open(file_path, "wb") as f:
                            writer.write(f)
                    else:
                        QMessageBox.warning(self, "pypdf fehlt", "Für mehrseitiges OCR-PDF wird 'python3-pypdf' benötigt.\nErstelle normales PDF ohne OCR.")
                        formatted_pages = [img.convert("RGB") for img in self.scanned_pages]
                        formatted_pages[0].save(
                            file_path, "PDF",
                            resolution=dpi_val[0],
                            dpi=dpi_val,
                            save_all=True,
                            append_images=formatted_pages[1:]
                        )
                else:
                    formatted_pages = [img.convert("RGB") for img in self.scanned_pages]
                    formatted_pages[0].save(
                        file_path, "PDF",
                        resolution=dpi_val[0],
                        dpi=dpi_val,
                        save_all=True,
                        append_images=formatted_pages[1:]
                    )

            else:
                for idx, img in enumerate(self.scanned_pages):
                    out_path = f"{base}_{idx+1}{ext}" if len(self.scanned_pages) > 1 else file_path
                    if ext.lower() in [".jpg", ".jpeg"]:
                        img.convert("RGB").save(out_path, "JPEG", quality=95, dpi=dpi_val)
                    else:
                        img.save(out_path, dpi=dpi_val)

            QMessageBox.information(self, "Erfolg", f"{len(self.scanned_pages)} Datei(en) erfolgreich gespeichert!")
            self.reset_pages()

        except Exception as e:
            QMessageBox.critical(self, "Speicher-Fehler", f"Fehler beim Speichern:\n{e}")

    def reset_pages(self):
        self.scanned_pages.clear()
        self.preview_pil_image = None
        self.preview_view.scene.clear()
        self.lbl_page_count.setText("Gescannte Seiten: 0")

    def quit_application(self):
        if self.scanned_pages:
            reply = QMessageBox.question(
                self,
                "Anwendung beenden",
                f"Es befinden sich noch {len(self.scanned_pages)} ungespeicherte Seite(n) im Speicher.\nMöchtest du wirklich beenden?",
                QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No,
                QMessageBox.StandardButton.No
            )
            if reply != QMessageBox.StandardButton.Yes:
                return

        try:
            sane.exit()
        except Exception:
            pass

        QApplication.quit()

    def closeEvent(self, event):
        if self.scanned_pages:
            reply = QMessageBox.question(
                self,
                "Anwendung beenden",
                f"Es befinden sich noch {len(self.scanned_pages)} ungespeicherte Seite(n) im Speicher.\nMöchtest du wirklich beenden?",
                QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No,
                QMessageBox.StandardButton.No
            )
            if reply == QMessageBox.StandardButton.Yes:
                try:
                    sane.exit()
                except Exception:
                    pass
                event.accept()
            else:
                event.ignore()
        else:
            try:
                sane.exit()
            except Exception:
                pass
            event.accept()



# --- Profil-Verwaltung (Home-Verzeichnis) ---
def get_config_path():
    config_dir = Path.home() / ".config" / "scanner_app"
    config_dir.mkdir(parents=True, exist_ok=True)
    return config_dir / "profiles.json"

def load_user_profiles():
    path = get_config_path()
    profiles = DEFAULT_PROFILES.copy()
    if path.exists():
        try:
            with open(path, "r", encoding="utf-8") as f:
                user_profs = json.load(f)
                profiles.update(user_profs)
        except Exception as e:
            print(f"Fehler beim Laden der Profile: {e}")
    return profiles

def save_user_profiles(profiles):
    path = get_config_path()
    try:
        with open(path, "w", encoding="utf-8") as f:
            json.dump(profiles, f, indent=4, ensure_ascii=False)
    except Exception as e:
        print(f"Fehler beim Speichern der Profile: {e}")


# --- Native OCR-Funktion ---
def run_native_ocr_pdf(pil_img, lang="deu+eng"):
    with tempfile.TemporaryDirectory() as tmp_dir:
        input_img_path = os.path.join(tmp_dir, "input.png")
        output_pdf_base = os.path.join(tmp_dir, "output")
        output_pdf_path = output_pdf_base + ".pdf"

        pil_img.save(input_img_path, format="PNG")

        cmd = [
            "tesseract",
            input_img_path,
            output_pdf_base,
            "-l", lang,
            "pdf"
        ]

        result = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)

        if result.returncode != 0:
            raise RuntimeError(f"Tesseract OCR-Fehler:\n{result.stderr.decode('utf-8')}")

        with open(output_pdf_path, "rb") as f:
            return f.read()


# --- Bildverarbeitungs-Helper ---
class ImageProcessor:
    @staticmethod
    def deskew(pil_img):
        """Verbessertes Geraderücken mittels Hough-Transform für reine Dokumente."""
        cv_img = cv2.cvtColor(np.array(pil_img), cv2.COLOR_RGB2BGR)
        gray = cv2.cvtColor(cv_img, cv2.COLOR_BGR2GRAY)

        edges = cv2.Canny(gray, 50, 150, apertureSize=3)
        lines = cv2.HoughLinesP(edges, 1, np.pi / 180, 100, minLineLength=100, maxLineGap=10)

        if lines is None:
            return pil_img

        angles = []
        for line in lines:
            x1, y1, x2, y2 = line[0]
            angle = np.degrees(np.arctan2(y2 - y1, x2 - x1))
            if -45 < angle < 45:
                angles.append(angle)

        if not angles:
            return pil_img

        median_angle = float(np.median(angles))

        if abs(median_angle) > 0.2:
            (h, w) = cv_img.shape[:2]
            center = (w // 2, h // 2)
            M = cv2.getRotationMatrix2D(center, median_angle, 1.0)
            rotated = cv2.warpAffine(cv_img, M, (w, h), flags=cv2.INTER_CUBIC, borderMode=cv2.BORDER_REPLICATE)
            return Image.fromarray(cv2.cvtColor(rotated, cv2.COLOR_BGR2RGB))

        return pil_img

    @staticmethod
    def extract_photos(pil_img):
        """
        Präzise Erkennung, Entzerrung und Zuschnitt von Objekten/Fotos auf der Scanfläche.
        Skaliert automatisch mit der Pixelauflösung.
        """
        cv_img = cv2.cvtColor(np.array(pil_img), cv2.COLOR_RGB2BGR)
        gray = cv2.cvtColor(cv_img, cv2.COLOR_BGR2GRAY)
        h_img, w_img = cv_img.shape[:2]

        kernel_size = max(5, int(min(h_img, w_img) * 0.01))
        if kernel_size % 2 == 0:
            kernel_size += 1

        blurred = cv2.GaussianBlur(gray, (5, 5), 0)
        edges = cv2.Canny(blurred, 30, 120)

        kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (kernel_size, kernel_size))
        closed = cv2.morphologyEx(edges, cv2.MORPH_CLOSE, kernel)

        contours, _ = cv2.findContours(closed, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        extracted_photos = []

        min_area = (h_img * w_img) * 0.02
        contours = sorted(contours, key=lambda c: cv2.boundingRect(c)[1])

        for c in contours:
            area = cv2.contourArea(c)
            if area > min_area:
                rect = cv2.minAreaRect(c)
                box = cv2.boxPoints(rect)
                box = np.float32(box)

                s = box.sum(axis=1)
                diff = np.diff(box, axis=1)

                rect_pts = np.zeros((4, 2), dtype="float32")
                rect_pts[0] = box[np.argmin(s)]
                rect_pts[2] = box[np.argmax(s)]
                rect_pts[1] = box[np.argmin(diff)]
                rect_pts[3] = box[np.argmax(diff)]

                width_a = np.linalg.norm(rect_pts[2] - rect_pts[3])
                width_b = np.linalg.norm(rect_pts[1] - rect_pts[0])
                maxWidth = max(int(width_a), int(width_b))

                height_a = np.linalg.norm(rect_pts[1] - rect_pts[2])
                height_b = np.linalg.norm(rect_pts[0] - rect_pts[3])
                maxHeight = max(int(height_a), int(height_b))

                if maxWidth < (w_img * 0.05) or maxHeight < (h_img * 0.05):
                    continue

                dst_pts = np.array([
                    [0, 0],
                    [maxWidth - 1, 0],
                    [maxWidth - 1, maxHeight - 1],
                    [0, maxHeight - 1]], dtype="float32")

                M = cv2.getPerspectiveTransform(rect_pts, dst_pts)
                warped = cv2.warpPerspective(cv_img, M, (maxWidth, maxHeight))

                if maxWidth > maxHeight:
                    warped = cv2.rotate(warped, cv2.ROTATE_90_COUNTERCLOCKWISE)

                photo_pil = Image.fromarray(cv2.cvtColor(warped, cv2.COLOR_BGR2RGB))
                extracted_photos.append(photo_pil)

        return extracted_photos if extracted_photos else [pil_img]

    @staticmethod
    def adjust_brightness_contrast(pil_img, brightness=1.0, contrast=1.0):
        if brightness != 1.0:
            enhancer = ImageEnhance.Brightness(pil_img)
            pil_img = enhancer.enhance(brightness)
        if contrast != 1.0:
            enhancer = ImageEnhance.Contrast(pil_img)
            pil_img = enhancer.enhance(contrast)
        return pil_img


# --- Vorschau & Auswahlrechteck ---
class SelectionRectItem(QGraphicsRectItem):
    def __init__(self, rect, parent=None):
        super().__init__(rect, parent)
        self.setPen(QPen(QColor(0, 120, 215), 2, Qt.PenStyle.DashLine))
        self.setBrush(QBrush(QColor(0, 120, 215, 35)))


class PreviewGraphicsView(QGraphicsView):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.scene = QGraphicsScene(self)
        self.setScene(self.scene)
        self.pixmap_item = None
        self.selection_item = None
        self.start_point = None
        self.is_drawing = False

    def set_image(self, pil_image):
        self.scene.clear()
        self.selection_item = None
        im_data = pil_image.convert("RGBA").tobytes("raw", "RGBA")
        qim = QImage(im_data, pil_image.width, pil_image.height, QImage.Format.Format_RGBA8888)
        pixmap = QPixmap.fromImage(qim)

        self.pixmap_item = QGraphicsPixmapItem(pixmap)
        self.scene.addItem(self.pixmap_item)
        self.scene.setSceneRect(QRectF(pixmap.rect()))
        self.fitInView(self.scene.sceneRect(), Qt.AspectRatioMode.KeepAspectRatio)

    def mousePressEvent(self, event):
        if self.pixmap_item and event.button() == Qt.MouseButton.LeftButton:
            scene_pos = self.mapToScene(event.pos())
            if self.pixmap_item.boundingRect().contains(scene_pos):
                self.start_point = scene_pos
                self.is_drawing = True
                if self.selection_item:
                    self.scene.removeItem(self.selection_item)
                    self.selection_item = None
                return
        super().mousePressEvent(event)

    def mouseMoveEvent(self, event):
        if self.is_drawing and self.start_point:
            current_pos = self.mapToScene(event.pos())
            rect = QRectF(self.start_point, current_pos).normalized()
            rect = rect.intersected(self.pixmap_item.boundingRect())

            if not self.selection_item:
                self.selection_item = SelectionRectItem(rect)
                self.scene.addItem(self.selection_item)
            else:
                self.selection_item.setRect(rect)
            return
        super().mouseMoveEvent(event)

    def mouseReleaseEvent(self, event):
        if event.button() == Qt.MouseButton.LeftButton and self.is_drawing:
            self.is_drawing = False
            return
        super().mouseReleaseEvent(event)

    def get_selection_rect(self):
        if self.selection_item and self.pixmap_item:
            rect = self.selection_item.rect()
            return (int(rect.left()), int(rect.top()), int(rect.right()), int(rect.bottom()))
        return None


# --- Hauptfenster ---
class ScannerApp(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Modern Scanner Studio Pro")
        self.resize(1200, 800)

        self.profiles = load_user_profiles()
        self.preview_pil_image = None

        self.init_sane()
        self.init_ui()

    def init_sane(self):
        try:
            sane.init()
            self.devices = sane.get_devices()
        except Exception as e:
            self.devices = []
            print(f"SANE Info: {e}")

    def init_ui(self):
        main_widget = QWidget()
        self.setCentralWidget(main_widget)
        main_layout = QHBoxLayout(main_widget)

        # === LINKE SEITENLEISTE ===
        sidebar_layout = QVBoxLayout()
        sidebar_widget = QWidget()
        sidebar_widget.setFixedWidth(340)
        sidebar_widget.setLayout(sidebar_layout)

        # 1. Profile
        profile_group = QGroupBox("Scan-Profil")
        prof_layout = QHBoxLayout()
        self.profile_combo = QComboBox()
        self.profile_combo.addItems(self.profiles.keys())
        self.profile_combo.currentTextChanged.connect(self.load_profile)

        btn_save_prof = QPushButton("💾")
        btn_save_prof.setToolTip("Aktuelle Einstellungen im User-Home speichern")
        btn_save_prof.clicked.connect(self.save_custom_profile)

        prof_layout.addWidget(self.profile_combo)
        prof_layout.addWidget(btn_save_prof)
        profile_group.setLayout(prof_layout)
        sidebar_layout.addWidget(profile_group)

        # 2. Hardware / Einstellungen
        hw_group = QGroupBox("Hardware")
        hw_layout = QFormLayout()
        self.device_combo = QComboBox()
        self.populate_devices()

        self.mode_combo = QComboBox()
        self.mode_combo.addItem("Farbe", "color")
        self.mode_combo.addItem("Graustufen", "gray")
        self.mode_combo.addItem("Schwarz/Weiß (Lineart)", "lineart")

        self.dpi_spin = QSpinBox()
        self.dpi_spin.setRange(75, 1200)
        self.dpi_spin.setSingleStep(75)
        self.dpi_spin.setSuffix(" DPI")

        hw_layout.addRow("Scanner:", self.device_combo)
        hw_layout.addRow("Modus:", self.mode_combo)
        hw_layout.addRow("Auflösung:", self.dpi_spin)
        hw_group.setLayout(hw_layout)
        sidebar_layout.addWidget(hw_group)

        # 3. Post-Processing & OCR
        proc_group = QGroupBox("Automatische Optimierung & OCR")
        proc_layout = QVBoxLayout()

        self.chk_deskew = QCheckBox("Geraderücken (Deskew)")
        self.chk_autocrop = QCheckBox("Foto Auto-Erkennung & Zuschnitt")
        self.chk_ocr = QCheckBox("Durchsuchbares PDF (OCR)")

        adj_layout = QFormLayout()
        self.spin_brightness = QDoubleSpinBox()
        self.spin_brightness.setRange(0.5, 2.0)
        self.spin_brightness.setSingleStep(0.1)

        self.spin_contrast = QDoubleSpinBox()
        self.spin_contrast.setRange(0.5, 2.0)
        self.spin_contrast.setSingleStep(0.1)

        adj_layout.addRow("Helligkeit:", self.spin_brightness)
        adj_layout.addRow("Kontrast:", self.spin_contrast)

        proc_layout.addWidget(self.chk_deskew)
        proc_layout.addWidget(self.chk_autocrop)
        proc_layout.addWidget(self.chk_ocr)
        proc_layout.addLayout(adj_layout)
        proc_group.setLayout(proc_layout)
        sidebar_layout.addWidget(proc_group)

        # Scan Buttons
        self.btn_preview = QPushButton("🔍 1. Vorschau scannen")
        self.btn_preview.setStyleSheet("font-weight: bold; padding: 8px;")
        self.btn_preview.clicked.connect(self.scan_preview)

        self.btn_scan = QPushButton("📄 2. Scan durchführen & Speichern")
        self.btn_scan.setStyleSheet("font-weight: bold; background-color: #0078D7; color: white; padding: 12px;")
        self.btn_scan.clicked.connect(self.scan_final)

        sidebar_layout.addWidget(self.btn_preview)
        sidebar_layout.addWidget(self.btn_scan)
        sidebar_layout.addStretch()

        # === RECHTER BEREICH ===
        self.preview_view = PreviewGraphicsView()

        main_layout.addWidget(sidebar_widget)
        main_layout.addWidget(self.preview_view)

        self.load_profile(self.profile_combo.currentText())

    def populate_devices(self):
        self.device_combo.clear()
        if self.devices:
            for dev in self.devices:
                self.device_combo.addItem(f"{dev[1]} {dev[2]}", dev[0])
        else:
            self.device_combo.addItem("Demo / Kein Scanner gefunden", None)

    def load_profile(self, profile_name):
        if profile_name in self.profiles:
            p = self.profiles[profile_name]
            self.dpi_spin.setValue(p.get("dpi", 300))

            idx = self.mode_combo.findData(p.get("mode", "color"))
            if idx >= 0: self.mode_combo.setCurrentIndex(idx)

            self.chk_ocr.setChecked(p.get("ocr", False))
            self.chk_deskew.setChecked(p.get("deskew", False))
            self.chk_autocrop.setChecked(p.get("autocrop", False))
            self.spin_brightness.setValue(p.get("brightness", 1.0))
            self.spin_contrast.setValue(p.get("contrast", 1.0))

    def save_custom_profile(self):
        name, ok = QInputDialog.getText(self, "Profil speichern", "Name für das neue Profil:")
        if ok and name:
            self.profiles[name] = {
                "dpi": self.dpi_spin.value(),
                "mode": self.mode_combo.currentData(),
                "ocr": self.chk_ocr.isChecked(),
                "deskew": self.chk_deskew.isChecked(),
                "autocrop": self.chk_autocrop.isChecked(),
                "brightness": self.spin_brightness.value(),
                "contrast": self.spin_contrast.value()
            }
            save_user_profiles(self.profiles)

            if self.profile_combo.findText(name) == -1:
                self.profile_combo.addItem(name)
            self.profile_combo.setCurrentText(name)
            QMessageBox.information(self, "Erfolg", f"Profil '{name}' wurde im Home-Verzeichnis gespeichert.")

    def open_sane_device(self):
        dev_name = self.device_combo.currentData()
        if not dev_name:
            return None
        try:
            return sane.open(dev_name)
        except Exception as e:
            QMessageBox.critical(self, "Fehler", f"Scanner konnte nicht geöffnet werden:\n{e}")
            return None

    def scan_preview(self):
        dev = self.open_sane_device()
        if dev:
            try:
                dev.mode = self.mode_combo.currentData()
                dev.resolution = 75
                if hasattr(dev, 'tl_x'): dev.tl_x = 0.0
                if hasattr(dev, 'tl_y'): dev.tl_y = 0.0
                if hasattr(dev, 'br_x') and hasattr(dev, 'tl_x_range'): dev.br_x = dev.tl_x_range[1]
                if hasattr(dev, 'br_y') and hasattr(dev, 'tl_y_range'): dev.br_y = dev.tl_y_range[1]

                dev.start()
                self.preview_pil_image = dev.snap()
                dev.close()
            except Exception as e:
                QMessageBox.warning(self, "Scan-Fehler", f"Vorschau fehlgeschlagen:\n{e}")
                return
        else:
            self.preview_pil_image = Image.new("RGB", (1240, 1754), color=(255, 255, 255))
            QMessageBox.information(self, "Demo-Modus", "Demo-Vorschau geladen.")

        self.preview_view.set_image(self.preview_pil_image)

    def scan_final(self):
        if not self.preview_pil_image:
            QMessageBox.warning(self, "Hinweis", "Bitte starte zuerst einen Vorschau-Scan.")
            return

        # Hinweismeldung bei automatischer Trennung mit > 300 DPI
        if self.chk_autocrop.isChecked() and self.dpi_spin.value() > 300:
            QMessageBox.information(
                self,
                "Hinweis zur Auto-Erkennung",
                "Bei Auflösungen über 300 DPI (z. B. 600 DPI) werden mehrere Objekte "
                "vom System eventuell als ein einzelnes Bild erkannt.\n\n"
                "Für das automatische Trennen mehrerer Fotos wird das Profil "
                "'Mehrere Fotos (300 dpi)' empfohlen."
            )

        file_filter = "JPEG Bild (*.jpg);;PDF Dokument (*.pdf);;PNG Bild (*.png)"
        file_path, selected_filter = QFileDialog.getSaveFileName(self, "Scan speichern", "Scan_Output", file_filter)

        if not file_path:
            return

        selection = self.preview_view.get_selection_rect()
        dev = self.open_sane_device()

        # 1. Scannen
        if dev:
            try:
                dev.mode = self.mode_combo.currentData()
                dev.resolution = self.dpi_spin.value()

                if selection:
                    x1, y1, x2, y2 = selection
                    w_pixel, h_pixel = self.preview_pil_image.size
                    max_x = dev.tl_x_range[1] if hasattr(dev, 'tl_x_range') else 215.0
                    max_y = dev.tl_y_range[1] if hasattr(dev, 'tl_y_range') else 297.0

                    dev.tl_x = (x1 / w_pixel) * max_x
                    dev.tl_y = (y1 / h_pixel) * max_y
                    dev.br_x = (x2 / w_pixel) * max_x
                    dev.br_y = (y2 / h_pixel) * max_y

                dev.start()
                scanned_img = dev.snap()
                dev.close()
            except Exception as e:
                QMessageBox.critical(self, "Scan-Fehler", f"Scan fehlgeschlagen:\n{e}")
                return
        else:
            if selection:
                scanned_img = self.preview_pil_image.crop(selection)
            else:
                scanned_img = self.preview_pil_image.copy()

        # 2. Bildverarbeitung & Extraktion
        extracted_images = []

        if self.chk_autocrop.isChecked():
            extracted_images = ImageProcessor.extract_photos(scanned_img)
        else:
            extracted_images = [scanned_img]

        # Post-Processing
        final_images = []
        for img in extracted_images:
            if self.chk_deskew.isChecked() and not self.chk_autocrop.isChecked():
                img = ImageProcessor.deskew(img)

            img = ImageProcessor.adjust_brightness_contrast(
                img,
                brightness=self.spin_brightness.value(),
                contrast=self.spin_contrast.value()
            )
            final_images.append(img)

        # 3. Speichern
        base, ext = os.path.splitext(file_path)
        if not ext:
            ext = ".jpg" if "JPEG" in selected_filter else ".pdf"

        try:
            for idx, img in enumerate(final_images):
                out_path = f"{base}_{idx+1}{ext}" if len(final_images) > 1 else f"{base}{ext}"

                if ext.lower() == ".pdf" and self.chk_ocr.isChecked():
                    pdf_bytes = run_native_ocr_pdf(img, lang="deu+eng")
                    with open(out_path, 'wb') as f:
                        f.write(pdf_bytes)
                elif ext.lower() == ".pdf":
                    img.convert("RGB").save(out_path, "PDF", resolution=float(self.dpi_spin.value()))
                elif ext.lower() in [".jpg", ".jpeg"]:
                    img.convert("RGB").save(out_path, "JPEG", quality=95)
                else:
                    img.save(out_path)

            msg = f"{len(final_images)} Bild(er) erfolgreich gespeichert!"
            QMessageBox.information(self, "Erfolg", msg)
        except Exception as e:
            QMessageBox.critical(self, "Speicher-Fehler", f"Fehler beim Speichern:\n{e}")


if __name__ == "__main__":
    app = QApplication(sys.argv)
    app.setStyle("Fusion")

    window = ScannerApp()
    window.show()
    sys.exit(app.exec())

    def populate_devices(self):
        self.device_combo.clear()
        if self.devices:
            for dev in self.devices:
                self.device_combo.addItem(f"{dev[1]} {dev[2]}", dev[0])
        else:
            self.device_combo.addItem("Demo / Kein Scanner gefunden", None)

    def load_profile(self, profile_name):
        if profile_name in self.profiles:
            p = self.profiles[profile_name]
            self.dpi_spin.setValue(p.get("dpi", 300))

            idx = self.mode_combo.findData(p.get("mode", "color"))
            if idx >= 0: self.mode_combo.setCurrentIndex(idx)

            self.chk_ocr.setChecked(p.get("ocr", False))
            self.chk_deskew.setChecked(p.get("deskew", False))
            self.chk_autocrop.setChecked(p.get("autocrop", False))
            self.spin_brightness.setValue(p.get("brightness", 1.0))
            self.spin_contrast.setValue(p.get("contrast", 1.0))
            self.spin_offset_x.setValue(p.get("offset_x", 0.0))
            self.spin_offset_y.setValue(p.get("offset_y", 0.0))
            self.selected_format = p.get("format", "PDF")

    def save_custom_profile(self):
        name, ok = QInputDialog.getText(self, "Profil speichern", "Name für das neue Profil:")
        if ok and name:
            self.profiles[name] = {
                "dpi": self.dpi_spin.value(),
                "mode": self.mode_combo.currentData(),
                "format": self.selected_format,
                "ocr": self.chk_ocr.isChecked(),
                "deskew": self.chk_deskew.isChecked(),
                "autocrop": self.chk_autocrop.isChecked(),
                "brightness": self.spin_brightness.value(),
                "contrast": self.spin_contrast.value(),
                "offset_x": self.spin_offset_x.value(),
                "offset_y": self.spin_offset_y.value()
            }
            save_user_profiles(self.profiles)

            if self.profile_combo.findText(name) == -1:
                self.profile_combo.addItem(name)
            self.profile_combo.setCurrentText(name)
            QMessageBox.information(self, "Erfolg", f"Profil '{name}' wurde im Home-Verzeichnis gespeichert.")

    def open_sane_device(self):
        dev_name = self.device_combo.currentData()
        if not dev_name:
            return None
        try:
            return sane.open(dev_name)
        except Exception as e:
            QMessageBox.critical(self, "Fehler", f"Scanner konnte nicht geöffnet werden:\n{e}")
            return None

    def scan_preview(self):
        dev = self.open_sane_device()
        if dev:
            try:
                dev.mode = self.mode_combo.currentData()
                dev.resolution = 75

                # Grenzwerte des Treibers genau ermitteln
                min_x = dev.tl_x_range[0] if hasattr(dev, 'tl_x_range') else 0.0
                max_x = dev.tl_x_range[1] if hasattr(dev, 'tl_x_range') else 215.9
                min_y = dev.tl_y_range[0] if hasattr(dev, 'tl_y_range') else 0.0
                max_y = dev.tl_y_range[1] if hasattr(dev, 'tl_y_range') else 297.0

                if hasattr(dev, 'tl_x'): dev.tl_x = min_x
                if hasattr(dev, 'tl_y'): dev.tl_y = min_y
                if hasattr(dev, 'br_x'): dev.br_x = max_x
                if hasattr(dev, 'br_y'): dev.br_y = max_y

                dev.start()
                self.preview_pil_image = dev.snap()
                dev.close()
            except Exception as e:
                QMessageBox.warning(self, "Scan-Fehler", f"Vorschau fehlgeschlagen:\n{e}")
                return
        else:
            self.preview_pil_image = Image.new("RGB", (1240, 1754), color=(255, 255, 255))
            QMessageBox.information(self, "Demo-Modus", "Demo-Vorschau geladen.")

        self.preview_view.set_image(self.preview_pil_image)

    def scan_final(self):
        if not self.preview_pil_image:
            QMessageBox.warning(self, "Hinweis", "Bitte starte zuerst einen Vorschau-Scan.")
            return

        filter_pdf = "PDF Dokument (*.pdf)"
        filter_jpg = "JPEG Bild (*.jpg)"
        filter_png = "PNG Bild (*.png)"

        if self.selected_format.upper() == "PDF" or self.chk_ocr.isChecked():
            file_filter = f"{filter_pdf};;{filter_jpg};;{filter_png}"
            initial_filter = filter_pdf
        else:
            file_filter = f"{filter_jpg};;{filter_pdf};;{filter_png}"
            initial_filter = filter_jpg

        file_path, selected_filter = QFileDialog.getSaveFileName(
            self,
            "Scan speichern",
            "Scan_Output",
            file_filter,
            initialFilter=initial_filter
        )

        if not file_path:
            return

        selection = self.preview_view.get_selection_rect()
        dev = self.open_sane_device()

        # 1. Scannen
        if dev:
            try:
                dev.mode = self.mode_combo.currentData()
                dev.resolution = self.dpi_spin.value()

                if selection:
                    x1, y1, x2, y2 = selection
                    w_pixel, h_pixel = self.preview_pil_image.size

                    # Minima und Maxima in mm
                    min_x = dev.tl_x_range[0] if hasattr(dev, 'tl_x_range') else 0.0
                    max_x = dev.tl_x_range[1] if hasattr(dev, 'tl_x_range') else 215.9
                    min_y = dev.tl_y_range[0] if hasattr(dev, 'tl_y_range') else 0.0
                    max_y = dev.tl_y_range[1] if hasattr(dev, 'tl_y_range') else 297.0

                    span_x = max_x - min_x
                    span_y = max_y - min_y

                    # Manuelle Offsets aus dem GUI (in mm)
                    off_x = self.spin_offset_x.value()
                    off_y = self.spin_offset_y.value()

                    # Exakte Transformation inklusive Treiber-Limits und manuellem Offset
                    calc_tl_x = min_x + (x1 / w_pixel) * span_x + off_x
                    calc_tl_y = min_y + (y1 / h_pixel) * span_y + off_y
                    calc_br_x = min_x + (x2 / w_pixel) * span_x + off_x
                    calc_br_y = min_y + (y2 / h_pixel) * span_y + off_y

                    # Absicherung gegen Überschreitung der Treibergrenzen
                    dev.tl_x = float(max(min_x, min(calc_tl_x, max_x)))
                    dev.tl_y = float(max(min_y, min(calc_tl_y, max_y)))
                    dev.br_x = float(max(min_x, min(calc_br_x, max_x)))
                    dev.br_y = float(max(min_y, min(calc_br_y, max_y)))

                dev.start()
                scanned_img = dev.snap()
                dev.close()
            except Exception as e:
                QMessageBox.critical(self, "Scan-Fehler", f"Scan fehlgeschlagen:\n{e}")
                return
        else:
            if selection:
                scanned_img = self.preview_pil_image.crop(selection)
            else:
                scanned_img = self.preview_pil_image.copy()

        # 2. Bildverarbeitung & Extraktion
        if selection or self.chk_ocr.isChecked():
            extracted_images = [scanned_img]
        elif self.chk_autocrop.isChecked():
            extracted_images = ImageProcessor.extract_photos(scanned_img)
        else:
            extracted_images = [scanned_img]

        # Post-Processing
        final_images = []
        for img in extracted_images:
            if self.chk_deskew.isChecked() and not selection:
                img = ImageProcessor.deskew(img)

            img = ImageProcessor.adjust_brightness_contrast(
                img,
                brightness=self.spin_brightness.value(),
                contrast=self.spin_contrast.value()
            )
            final_images.append(img)

        # 3. Speichern
        base, ext = os.path.splitext(file_path)
        if not ext:
            ext = ".pdf" if "PDF" in selected_filter else ".jpg"

        try:
            for idx, img in enumerate(final_images):
                out_path = f"{base}_{idx+1}{ext}" if len(final_images) > 1 else f"{base}{ext}"

                if ext.lower() == ".pdf" and self.chk_ocr.isChecked():
                    pdf_bytes = run_native_ocr_pdf(img, lang="deu+eng")
                    with open(out_path, 'wb') as f:
                        f.write(pdf_bytes)
                elif ext.lower() == ".pdf":
                    img.convert("RGB").save(out_path, "PDF", resolution=float(self.dpi_spin.value()))
                elif ext.lower() in [".jpg", ".jpeg"]:
                    img.convert("RGB").save(out_path, "JPEG", quality=95)
                else:
                    img.save(out_path)

            msg = f"{len(final_images)} Bild(er) erfolgreich gespeichert!"
            QMessageBox.information(self, "Erfolg", msg)
        except Exception as e:
            QMessageBox.critical(self, "Speicher-Fehler", f"Fehler beim Speichern:\n{e}")


if __name__ == "__main__":
    app = QApplication(sys.argv)
    app.setStyle("Fusion")

    window = ScannerApp()
    window.show()
    sys.exit(app.exec())
